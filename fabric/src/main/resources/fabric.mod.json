{
  "schemaVersion": 1,
  "id": "virtualloot",
  "version": "${version}",
  "name": "Virtual Loot: MultiVerse",
  "description": "Lag-free Virtual Pasture system with universal multi-mod compatibility for Cobblebase, Cobbreeding, Cobbleworkers, and Cobblemon.",
  "authors": [
    "LunazStudios",
    "notlown",
    "gxenzy"
  ],
  "contact": {
    "homepage": ""
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lunazstudios.virtualloot.fabric.VirtualLootFabric"
    ],
    "client": [
      "com.lunazstudios.virtualloot.fabric.client.VirtualLootFabricClient"
    ]
  },
  "mixins": [
    "virtualloot.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.8",
    "fabric-api": "*",
    "cobblemon": "${cobblemon_version_range}"
  },
  "recommends": {
    "cobblebase": ">=2.0.0",
    "cobbleworkers": "${cobbleworkers_version_range}",
    "cobbreeding": "${cobbreeding_version_range}"
  }
}
